{
  "name": "healthex-patient-data-refresh-orchestrator",
  "version": "1.0.0",
  "description": "Patient data refresh orchestrator using Fastify, PostgreSQL, Redis, and BullMQ.",
  "main": "dist/index.js",
  "scripts": {
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "wait:services": "tsx scripts/waitForServices.ts",
    "queue:clear": "tsx scripts/clearQueue.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "bootstrap": "npm run infra:up && npm run wait:services && npm run queue:clear && npm run db:seed",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "verify": "npm run typecheck && npm run build",
    "seed": "npm run db:seed",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/workers/refreshWorker.ts",
    "worker:start": "node dist/workers/refreshWorker.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bullmq": "^5.46.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
